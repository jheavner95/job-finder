{
  "name": "job-search-intelligence",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "local:start": "node scripts/local-start.mjs",
    "local:stop": "node scripts/local-stop.mjs",
    "local:open": "node scripts/local-open.mjs",
    "scheduler:run": "tsx scripts/run-scheduled-discovery.ts",
    "intelligence:backfill": "tsx scripts/backfill-candidate-intelligence.ts",
    "evidence:complete": "tsx scripts/complete-candidate-evidence.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/ensure-sqlite.mjs && prisma migrate deploy",
    "db:backup": "node scripts/sqlite-backup.mjs",
    "db:restore": "node scripts/sqlite-restore.mjs",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "mammoth": "^1.12.0",
    "next": "^16.2.11",
    "pdf-parse": "^2.4.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.11",
    "jszip": "^3.10.1",
    "prisma": "^6.19.3",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
