{
  "name": "AI Product Experience Benchmark",
  "capturedAt": "2026-08-09",
  "description": "Externally curated set of currently-open roles where product/UX/interaction/conversation design meaningfully intersects with AI products. Built independently of Job Finder's own relevance screen so it can measure that screen's blind spots. Qualification came from the posting body, not the title alone; roles that were ordinary design jobs at AI companies were rejected and the reason recorded.",
  "methodology": {
    "employersProbed": 110,
    "boardsResolved": 74,
    "postingsScanned": 8887,
    "designTitledRoles": 138,
    "qualifying": 27,
    "rejectedAfterReview": 6,
    "qualificationRule": "Explicit AI domain in the title, OR >=2 substantive human-AI experience responsibilities in the posting body; then hand-screened to exclude company-blurb-only and AI-as-designer-tool roles."
  },
  "rejectedExamples": [
    {
      "role": "harvey::staff product designer",
      "reason": "AI appears only in the company blurb; role responsibilities are generic product design."
    },
    {
      "role": "abridge::senior product designer",
      "reason": "AI is company/product context; role section asks for generic product design, 'bonus points for AI experience'."
    },
    {
      "role": "abridge::staff product designer",
      "reason": "AI is company/product context; role section asks for generic product design, 'bonus points for AI experience'."
    },
    {
      "role": "vercel::senior product designer, growth",
      "reason": "AI signals are the company tagline plus LLM tool access as a perk, not a design responsibility."
    },
    {
      "role": "decagon::brand designer",
      "reason": "Brand/social craft, outside product-design disciplines; AI is company context only."
    },
    {
      "role": "1password::product designer",
      "reason": "AI referenced as a tool the designer uses (Figma Make, Cursor), not as the product experience being designed."
    }
  ],
