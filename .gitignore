# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
/.local/
/backups/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
*.db
*.db-journal
*.db-shm
*.db-wal
/context/*.md
!/context/README.md
/dist/
/.wrangler/
/outputs/
/work/
/artifacts/
/uploads/
/screenshots/
*.sqlite
*.sqlite3
*.backup
*.bak
*.log
*.tmp
*.temp
*.swp
*.swo
*.orig
*.rej
.env.local
.env.development.local
.env.test.local
.env.production.local

# machine-specific dev-server launch config (contains absolute paths)
/.claude/launch.json

# generated benchmark measurement output (regenerated by npm run coverage:benchmark)
/dev/benchmark/last-run.json
