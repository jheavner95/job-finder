generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  NEW
  STRONG_MATCH
  POSSIBLE
  REJECTED
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  CLOSED
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  website   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]
}

model JobSource {
  id          String   @id @default(cuid())
  name        String   @unique
  baseUrl     String?
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  jobs        Job[]
  searchRuns  SearchRun[]
}

model Job {
  id                    String   @id @default(cuid())
  sourceJobId           String?
  fingerprint           String   @unique
  title                 String
  department            String?
  location              String?
  remoteStatus          String?
  employmentType        String?
  compensationMin       Int?
  compensationMax       Int?
  compensationCurrency  String?
  compensationText      String?
  sourceUrl              String
  applicationUrl         String?
  originalSourceText     String
  normalizedDescription String?
  normalizedRequirements Json?
  normalizedConcerns     Json?
  postedAt               DateTime?
  sourceUpdatedAt        DateTime?
  firstSeenAt            DateTime @default(now())
  lastSeenAt             DateTime @default(now())
  closedAt               DateTime?
  reconciliationReason   String?
  status                 JobStatus @default(NEW)
  isSynthetic            Boolean @default(false)
  companyId              String
  sourceId               String
  company                Company @relation(fields: [companyId], references: [id])
  source                 JobSource @relation(fields: [sourceId], references: [id])
  evaluations            JobEvaluation[]
  decisions              UserDecision[]
  application            Application?
  activity               ActivityEvent[]
  intelligence           OpportunityIntelligence?
  eligibility            JobEligibilityAssessment?
  searchRuns             SearchRun[] @relation("JobsInSearchRun")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([postedAt])
  @@unique([sourceId, companyId, sourceJobId])
}

model JobEvaluation {
  id               String   @id @default(cuid())
  score            Int
  reasoning        Json
  categoryResults  Json
  scoringVersion   String
  evaluatedAt      DateTime @default(now())
  jobId            String
  job              Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  evidence         CandidateEvidence[]

  @@index([jobId, evaluatedAt])
}

// Eligibility is stored apart from JobEvaluation on purpose.
//
// A match score answers "how well does this role fit?"; eligibility answers
// "can this candidate pursue it?". They also change for different reasons: a
// score is only valid for the scoring run that produced it, whereas an
// eligibility verdict has to be recomputed whenever the candidate updates their
// declared work authorization — with no rescoring, and no risk of disturbing a
// persisted score or tier.
model JobEligibilityAssessment {
  id              String   @id @default(cuid())
  verdict         String
  headline        String
  // Full PostingConstraint[] including informational findings, each carrying
  // its verbatim evidence so the user can check any verdict against the source.
  constraints     Json
  detectorVersion String
  // Null when the verdict was reached with no declared candidate facts.
  candidateFactsUpdatedAt DateTime?
  assessedAt      DateTime @default(now())
  jobId           String   @unique
  job             Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([verdict])
}

model CandidateEvidence {
  id            String   @id @default(cuid())
  contextFile   String
  label         String
  excerpt       String
  relevance     String
  createdAt     DateTime @default(now())
  evaluationId  String
  evaluation    JobEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
}

model UserDecision {
  id        String   @id @default(cuid())
  decision  JobStatus
  reason    String?
  decidedAt DateTime @default(now())
  jobId     String
  job       Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, decidedAt])
}

model Application {
  id                String   @id @default(cuid())
  status            String   @default("Preparing")
  currentStage      String   @default("Preparing")
  appliedAt         DateTime?
  applicationUrl    String?
  company           String
  role              String
  location          String?
  salary            String?
  recruiter         String?
  hiringManager     String?
  sourceProvider    String?
  industry          String?
  outcome           String?
  outcomeDate       DateTime?
  rejectionReason   String?
  futureEligibility String?
  startDate         DateTime?
  compensationNotes String?
  archived          Boolean  @default(false)
  notes             String?
  nextStepAt        DateTime?
  jobId             String   @unique
  job               Job @relation(fields: [jobId], references: [id], onDelete: Restrict)
  statusHistory     ApplicationStatusHistory[]
  timeline          ApplicationTimelineEvent[]
  contacts          ApplicationContact[]
  communications    ApplicationCommunication[]
  documents         ApplicationDocument[]
  interviews        ApplicationInterview[]
  followUps         ApplicationFollowUp[]
  attentionDismissals ApplicationAttentionDismissal[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, archived])
  @@index([appliedAt])
}

model ApplicationStatusHistory {
  id            String   @id @default(cuid())
  status        String
  notes         String?
  createdAt     DateTime @default(now())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model ApplicationTimelineEvent {
  id                String   @id @default(cuid())
  type              String
  notes             String?
  eventAt           DateTime @default(now())
  applicationId     String
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  relatedContactId  String?
  relatedContact    ApplicationContact? @relation(fields: [relatedContactId], references: [id], onDelete: SetNull)
  relatedDocumentId String?
  relatedDocument   ApplicationDocument? @relation(fields: [relatedDocumentId], references: [id], onDelete: SetNull)

  @@index([applicationId, eventAt])
}

model ApplicationContact {
  id             String   @id @default(cuid())
  kind           String
  name           String
  role           String?
  email          String?
  linkedin       String?
  notes          String?
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  timelineEvents ApplicationTimelineEvent[]
  communications ApplicationCommunication[]
  followUps       ApplicationFollowUp[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([applicationId, kind])
}

model ApplicationCommunication {
  id            String   @id @default(cuid())
  channel       String
  direction     String
  summary       String
  occurredAt    DateTime
  attachment    String?
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       ApplicationContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([applicationId, occurredAt])
}

model ApplicationDocument {
  id             String   @id @default(cuid())
  kind           String
  versionLabel   String
  referenceUrl   String?
  notes          String?
  submittedAt    DateTime?
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  timelineEvents ApplicationTimelineEvent[]
  createdAt      DateTime @default(now())

  @@index([applicationId, kind])
}

model ApplicationInterview {
  id               String   @id @default(cuid())
  round            String
  type             String
  participants     String?
  scheduledAt      DateTime
  durationMinutes  Int?
  timezone         String?
  format           String?
  locationUrl      String?
  preparationNotes String?
  questionsToAsk   String?
  postInterviewNotes String?
  feedback         String?
  outcome          String?
  followUpRequired Boolean @default(false)
  completedAt      DateTime?
  cancelledAt      DateTime?
  applicationId    String
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([applicationId, scheduledAt])
}

model ApplicationFollowUp {
  id            String   @id @default(cuid())
  type          String
  description   String
  notes         String?
  dueAt         DateTime
  completedAt   DateTime?
  snoozedFrom   DateTime?
  cancelledAt   DateTime?
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       ApplicationContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([dueAt, completedAt])
  @@index([applicationId])
  @@index([contactId])
}

model ApplicationAttentionDismissal {
  id            String   @id @default(cuid())
  attentionType String
  dismissedAt   DateTime @default(now())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, attentionType])
  @@index([applicationId])
}

model CareerPerformanceSettings {
  id            String   @id
  minSampleSize Int      @default(5)
  updatedAt     DateTime @updatedAt
}

model ActivityEvent {
  id        String   @id @default(cuid())
  type      String
  summary   String
  metadata  Json?
  createdAt DateTime @default(now())
  jobId     String?
  job       Job? @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model SearchRun {
  id          String   @id @default(cuid())
  query       Json
  status      String
  startedAt   DateTime @default(now())
  completedAt DateTime?
  sourceId    String?
  source      JobSource? @relation(fields: [sourceId], references: [id])
  jobs        Job[] @relation("JobsInSearchRun")
}

model Report {
  id          String   @id @default(cuid())
  type        String
  periodStart DateTime
  periodEnd   DateTime
  title       String
  content     Json
  generatedAt DateTime @default(now())
}

model CompanyConnector {
  id                  String   @id @default(cuid())
  company             String   @unique
  careerUrl           String
  atsType             String
  connectorKey        String
  searchCriteria      Json?
  robotsPolicy        String?
  crawlDelay          Int?
  rateLimit           Int?
  enabled             Boolean  @default(true)
  health              String   @default("Disabled")
  lastChecked         DateTime?
  lastSuccessfulFetch DateTime?
  notes               String?
  credentialStatus    String   @default("NotRequired")
  credentialCheckedAt DateTime?
  credentialRegion    String?
  feedStatus          String   @default("NotRequired")
  feedCheckedAt       DateTime?
  feedOrigin          String?
  feedPath            String?
  feedVersion         String?
  // Provenance and coverage accounting for boards the employer discovery layer
  // registered automatically. Manual entries keep the defaults.
  discoverySource     String   @default("manual")
  discoveryConfidence Int      @default(100)
  validationStatus    String   @default("Unvalidated")
  jobsAvailable       Int      @default(0)
  relevantRoles       Int      @default(0)
  lastValidatedAt     DateTime?
  boardFingerprint    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  crawlRuns           ConnectorCrawl[]
  schedule            ConnectorSchedule?

  @@index([atsType, enabled])
  @@unique([atsType, connectorKey])
  @@index([health])
  @@index([discoverySource])
  @@index([validationStatus])
}

/// A company name observed from a compliant public source, awaiting resolution
/// to a public ATS board. This is the working set of the employer discovery
/// layer; resolved rows point at the CompanyConnector they produced.
model EmployerCandidate {
  id               String   @id @default(cuid())
  name             String
  normalizedName   String   @unique
  source           String
  status           String   @default("Pending")
  attempts         Int      @default(0)
  probesUsed       Int      @default(0)
  lastAttemptAt    DateTime?
  resolvedProvider String?
  resolvedKey      String?
  connectorId      String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, lastAttemptAt])
  @@index([source])
}

model GreenhouseComparisonItem {
  id             String   @id @default(cuid())
  submittedUrl   String
  canonicalUrl   String?
  boardToken     String?
  companyName    String?
  status         String
  reason         String
  connectorId    String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([boardToken])
}

model ConnectorCrawl {
  id            String   @id @default(cuid())
  status        String
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  jobsDiscovered Int     @default(0)
  jobsImported  Int      @default(0)
  duplicates    Int      @default(0)
  failures      Int      @default(0)
  durationMs    Int?
  lastError     String?
  errorCode     String?
  providerMessage String?
  diagnosticContext Json?
  metadata      Json?
  connectorId   String
  connector     CompanyConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  batchId       String?
  batch         DiscoveryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([connectorId, startedAt])
  @@index([status])
  @@index([batchId])
  @@index([errorCode])
}

model ConnectorSchedule {
  id              String   @id @default(cuid())
  scheduleType    String   @default("Manual")
  timeOfDay       String?
  weekday         Int?
  intervalMinutes Int?
  nextRunAt       DateTime?
  lastRunAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  connectorId     String   @unique
  connector       CompanyConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@index([scheduleType, nextRunAt])
}

model DiscoveryBatch {
  id             String   @id @default(cuid())
  trigger        String
  status         String
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  durationMs     Int?
  connectorsRun  Int      @default(0)
  jobsDiscovered Int      @default(0)
  jobsImported   Int      @default(0)
  duplicates     Int      @default(0)
  failures       Int      @default(0)
  cancelRequested Boolean @default(false)
  metadata       Json?
  crawlRuns      ConnectorCrawl[]

  @@index([startedAt])
  @@index([status])
}

model SchedulerLock {
  id        String   @id
  lockToken String?
  lockedAt  DateTime?
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String
  href      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([readAt, createdAt])
  @@index([type])
}

model CandidateProfile {
  id              String   @id
  displayName     String
  headline        String
  yearsExperience Int?
  // Work-authorization facts the candidate declared themselves. Never derived
  // from a resume, an email domain, or the locations of saved jobs. Null means
  // "not declared", which produces a review prompt rather than an exclusion.
  eligibilityFacts Json?
  sourceUpdatedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  evidence        CandidateIntelligenceEvidence[]
  portfolio       CandidatePortfolioProject[]
  resumeEvidence  CandidateResumeEvidence[]
  resumeReadiness CandidateResumeReadiness?
  onboarding       CandidateOnboarding?
  resumeImports    CandidateResumeImport[]
  careerPreferences CandidateCareerPreferences?
  projectProgress  CandidateProjectProgress[]
}

model CandidateOnboarding {
  id                 String   @id
  currentStep        Int      @default(1)
  highestStep        Int      @default(1)
  startedAt          DateTime @default(now())
  completedAt        DateTime?
  baselineReadiness  Int      @default(0)
  completionReadiness Int?
  updatedAt          DateTime @updatedAt
  profileId          String   @unique
  profile            CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model CandidateResumeImport {
  id             String   @id @default(cuid())
  fileName       String
  fileType       String
  sourceText     String
  parsedEvidence Json
  status         String   @default("Preview")
  createdAt      DateTime @default(now())
  approvedAt     DateTime?
  profileId      String
  profile        CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

model CandidateCareerPreferences {
  id                String   @id
  preferredRoles    Json
  preferredIndustries Json
  workMode          String?
  compensation      String?
  companyExclusions Json
  employmentTypes   Json
  updatedAt         DateTime @updatedAt
  profileId         String   @unique
  profile           CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model CandidateProjectProgress {
  id             String   @id @default(cuid())
  status         String   @default("Needs evidence")
  notes          String?
  screenshotName String?
  updatedAt      DateTime @updatedAt
  profileId      String
  profile        CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  projectId      String

  @@unique([profileId, projectId])
  @@index([profileId, status])
}

model CandidateIntelligenceEvidence {
  id             String   @id
  category       String
  label          String
  sourceDocument String
  sourceExcerpt  String
  keywords       Json
  confidence     String
  evidenceQuality String @default("Unknown")
  projectName    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  profileId      String
  profile        CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  projectLinks   CandidateCapabilityProjectLink[]
  resumeLinks    CandidateCapabilityResumeLink[]

  @@index([profileId, category])
  @@index([label])
}

model CandidatePortfolioProject {
  id             String   @id
  name           String
  evidenceStatus String
  sourceDocument String
  sourceExcerpt  String
  employer       String?
  timeframe      String?
  role           String?
  responsibilities Json?
  problem        String?
  solution       String?
  businessOutcome String?
  designOutcome  String?
  researchPerformed String?
  leadershipDemonstrated String?
  crossFunctionalPartners Json?
  industry       String?
  productType    String?
  platform       String?
  enterpriseScale String?
  designSystemUsage String?
  accessibilityWork String?
  aiUsage        String?
  artifactsAvailable Json?
  confidentiality String?
  evidenceQuality String @default("Unknown")
  documentationCompleteness Int @default(0)
  visualEvidenceReadiness Int @default(0)
  outcomeEvidenceReadiness Int @default(0)
  interviewReadiness Int @default(0)
  portfolioReadiness Int @default(0)
  confidence     Int @default(0)
  archivedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  profileId      String
  profile        CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  capabilityLinks CandidateCapabilityProjectLink[]

  @@unique([profileId, name])
  @@index([profileId, archivedAt])
}

model CandidateResumeEvidence {
  id                 String   @id @default(cuid())
  employer           String
  title              String
  startDate          String?
  endDate            String?
  responsibilities   Json
  leadership         Json
  domains            Json
  industries         Json
  products           Json
  technologies       Json
  methods            Json
  collaboration      Json
  research           Json
  accessibility      Json
  ai                  Json
  designSystems      Json
  enterprise         Json
  sourceDocument     String
  sourceExcerpt      String
  evidenceQuality    String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  profileId          String
  profile            CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  capabilityLinks    CandidateCapabilityResumeLink[]

  @@index([profileId, employer])
}

model CandidateCapabilityProjectLink {
  id             String   @id @default(cuid())
  supportReason  String
  sourceExcerpt  String
  evidenceQuality String
  createdAt      DateTime @default(now())
  capabilityId   String
  capability     CandidateIntelligenceEvidence @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  projectId      String
  project        CandidatePortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([capabilityId, projectId])
  @@index([projectId])
}

model CandidateCapabilityResumeLink {
  id             String   @id @default(cuid())
  supportReason  String
  sourceExcerpt  String
  evidenceQuality String
  createdAt      DateTime @default(now())
  capabilityId   String
  capability     CandidateIntelligenceEvidence @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  resumeEvidenceId String
  resumeEvidence CandidateResumeEvidence @relation(fields: [resumeEvidenceId], references: [id], onDelete: Cascade)

  @@unique([capabilityId, resumeEvidenceId])
  @@index([resumeEvidenceId])
}

model CandidateResumeReadiness {
  id                    String   @id
  capabilityCoverage    Int
  industryCoverage      Int
  domainCoverage        Int
  leadershipCoverage    Int
  portfolioSupport      Int
  capabilitiesWithoutResume Json
  capabilitiesWithoutPortfolio Json
  evidenceDistribution Json
  calculatedAt          DateTime @default(now())
  updatedAt             DateTime @updatedAt
  profileId             String   @unique
  profile               CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model OpportunityIntelligence {
  id                       String   @id @default(cuid())
  version                  String
  topReason                String
  strengths                Json
  missingEvidence          Json
  concerns                 Json
  confidenceExplanation    String
  matchedSkills            Json
  matchedIndustries        Json
  matchedDomains           Json
  leadershipSignals        Json
  portfolioRecommendations Json
  resumeRecommendations    Json
  interviewTopics          Json
  preparationChecklist     Json
  generatedAt              DateTime @default(now())
  updatedAt                DateTime @updatedAt
  jobId                    String   @unique
  job                      Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([generatedAt])
}
